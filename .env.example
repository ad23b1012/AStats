# AStats Environment Variables

# ==========================================
# LLM Providers (AT LEAST ONE IS REQUIRED)
# ==========================================

# 1. Gemini (Default, highly recommended, free tier available)
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq (Fastest, Llama/Mixtral models, free tier available)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ==========================================
# Application Configuration (Optional)
# ==========================================

# Default LLM Provider (gemini or groq)
ASTATS_LLM_PROVIDER=gemini

# Default Model (if not set, uses provider defaults)
# Gemini: gemini-2.5-flash
# Groq: llama-3.3-70b-versatile
# ASTATS_LLM_MODEL=gemini-2.5-flash

# Default Autonomy Level (full-auto, semi-auto, step-by-step)
ASTATS_AUTONOMY_LEVEL=semi-auto

# Directories (Relative to where you run the command)
ASTATS_OUTPUT_DIR=./output
ASTATS_STORAGE_DIR=~/.astats

# Logging Level (DEBUG, INFO, WARNING, ERROR)
ASTATS_LOG_LEVEL=INFO
